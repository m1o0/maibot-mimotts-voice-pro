{
  "manifest_version": 2,
  "id": "m1o0.maibot-mimotts-voice-pro",
  "name": "MiMo TTS Voice Clone (Pro)",
  "version": "1.9.8",
  "description": "MiMo TTS Voice Clone Plugin for MaiBot - 语音回复插件，带请求超时、退避重试、并发上限与失败自动退回文字，并支持 ffmpeg 本地音高/语速/响度调整",
  "author": {
    "name": "m1o0",
    "url": "https://github.com/m1o0"
  },
  "license": "MIT",
  "plugin_type": "media",
  "urls": {
    "repository": "https://github.com/m1o0/maibot-mimotts-voice-pro",
    "homepage": "https://github.com/m1o0/maibot-mimotts-voice-pro",
    "issues": "https://github.com/m1o0/maibot-mimotts-voice-pro/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "1.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.text",
    "send.custom",
    "message.get_by_id",
    "chat.get_all_streams"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
